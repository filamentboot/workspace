{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravelstack/filament-admin-site",
    "description": "面向中小企业的前台官网管理插件，提供案例/方案/产品/页面/询盘五类内容管理，支持中英双语与主题切换。",
    "type": "library",
    "license": "MIT",
    "keywords": ["filament", "laravel", "website", "cms", "official-site", "filament-plugin", "bilingual"],
    "homepage": "https://github.com/johnson9316-bit/filament-admin-site",
    "authors": [
        {
            "name": "johncaptain",
            "email": "JasonTodd0521@gmail.com",
            "role": "developer"
        }
    ],
    "support": {
        "issues": "https://github.com/johnson9316-bit/filament-admin-site/issues",
        "source": "https://github.com/johnson9316-bit/filament-admin-site",
        "docs": "https://github.com/johnson9316-bit/filament-admin-site/blob/main/wiki/site.md",
        "wiki": "https://github.com/johnson9316-bit/filament-admin-site/tree/main/wiki"
    },
    "require": {
        "php": "^8.3",
        "danharrin/livewire-rate-limiting": "^2.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.6",
        "filament/spatie-laravel-settings-plugin": "^5.6",
        "laravelstack/filament-admin": "*",
        "laravelstack/filament-admin-rich-editor": "*",
        "livewire/livewire": "^4.3",
        "mews/purifier": "^3.4",
        "spatie/laravel-settings": "^3.9"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "LaravelStack\\FilamentAdminSite\\": "src/",
            "LaravelStack\\FilamentAdminSite\\Database\\Factories\\": "database/factories/",
            "LaravelStack\\FilamentAdminSite\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelStack\\FilamentAdminSite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelStack\\FilamentAdminSite\\SiteServiceProvider"
            ]
        },
        "filament-admin": {
            "slug": "filament-admin-site",
            "name": "官网插件",
            "type": "solution_plugin",
            "source": "official_trusted",
            "plugin_class": "LaravelStack\\FilamentAdminSite\\SitePlugin",
            "settings_page_slug": "settings/site",
            "service_provider": "LaravelStack\\FilamentAdminSite\\SiteServiceProvider",
            "description": "面向中小企业的前台官网管理插件（案例/方案/产品/页面/询盘五类内容，双语+主题可切换）",
            "requires": ["laravelstack/filament-admin"],
            "compatibility": {
                "laravel/framework": "^13.0",
                "filament/filament": "^5.0"
            }
        },
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test-coverage": "vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover=coverage.xml",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
