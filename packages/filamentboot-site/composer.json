{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "filamentboot/filamentboot-site",
    "description": "面向中小企业的前台官网管理插件，提供案例/方案/产品/资讯/页面/询盘六类内容管理，中文单语言，支持主题切换。",
    "type": "library",
    "license": "MIT",
    "keywords": ["filament", "laravel", "website", "cms", "official-site", "filament-plugin"],
    "homepage": "https://github.com/filamentboot/filamentboot-site",
    "authors": [
        {
            "name": "johncaptain",
            "email": "JasonTodd0521@gmail.com",
            "role": "developer"
        }
    ],
    "support": {
        "issues": "https://github.com/filamentboot/filamentboot-site/issues",
        "source": "https://github.com/filamentboot/filamentboot-site",
        "docs": "https://github.com/filamentboot/filamentboot-site/blob/main/wiki/site.md",
        "wiki": "https://github.com/filamentboot/filamentboot-site/tree/main/wiki"
    },
    "require": {
        "php": "^8.3",
        "danharrin/livewire-rate-limiting": "^2.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.6",
        "filament/spatie-laravel-settings-plugin": "^5.6",
        "filamentboot/filamentboot": "*",
        "livewire/livewire": "^4.3",
        "mews/purifier": "^3.4",
        "spatie/laravel-settings": "^3.9"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "Filamentboot\\FilamentbootSite\\": "src/",
            "Filamentboot\\FilamentbootSite\\Database\\Factories\\": "database/factories/",
            "Filamentboot\\FilamentbootSite\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filamentboot\\FilamentbootSite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filamentboot\\FilamentbootSite\\SiteServiceProvider"
            ]
        },
        "filamentboot": {
            "slug": "filamentboot-site",
            "name": "官网插件",
            "type": "solution_plugin",
            "source": "official_trusted",
            "plugin_class": "Filamentboot\\FilamentbootSite\\SitePlugin",
            "settings_page_slug": "settings/site",
            "service_provider": "Filamentboot\\FilamentbootSite\\SiteServiceProvider",
            "description": "面向中小企业的前台官网管理插件（案例/方案/产品/资讯/页面/询盘六类内容，中文单语言，主题可切换）",
            "requires": ["filamentboot/filamentboot"],
            "compatibility": {
                "laravel/framework": "^13.0",
                "filament/filament": "^5.0"
            },
            "post_install": {
                "publish_tags": ["filamentboot-site-config", "filamentboot-site-assets"],
                "run_migrations": true,
                "seeders": [
                    "Filamentboot\\FilamentbootSite\\Database\\Seeders\\SitePermissionSeeder",
                    "Filamentboot\\FilamentbootSite\\Database\\Seeders\\SiteMenuSeeder",
                    "Filamentboot\\FilamentbootSite\\Database\\Seeders\\SiteDemoSeeder",
                    "Filamentboot\\FilamentbootSite\\Database\\Seeders\\SiteNewsSeeder"
                ]
            }
        },
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test-coverage": "vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover=coverage.xml",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
