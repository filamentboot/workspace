{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "filamentboot/preview",
    "type": "project",
    "description": "Demo application for the FilamentAdmin package.",
    "keywords": [
        "filament",
        "laravel",
        "admin",
        "rbac",
        "backend"
    ],
    "license": "MIT",
    "homepage": "https://github.com/john-captain/filament-admin",
    "authors": [
        {
            "name": "johncaptain"
        }
    ],
    "support": {
        "issues": "https://github.com/john-captain/filament-admin/issues",
        "source": "https://github.com/john-captain/filament-admin"
    },
    "require": {
        "php": "^8.3",
        "alizharb/filament-activity-log": "^1.3",
        "bezhansalleh/filament-shield": "^4.0",
        "filamentboot/filamentboot": "@dev",
        "laravelstack/filament-admin-cos": "@dev",
        "laravelstack/filament-admin-markdown-editor": "@dev",
        "laravelstack/filament-admin-oss": "@dev",
        "laravelstack/filament-admin-rich-editor": "@dev",
        "laravelstack/filament-admin-site": "@dev",
        "laravelstack/filament-admin-wang-editor": "@dev",
        "mews/purifier": "^3.4",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.6",
        "filament/spatie-laravel-settings-plugin": "^5.6",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "solution-forest/filament-tree": "^4.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-settings": "^3.9",
        "stephenjude/filament-two-factor-authentication": "^4.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/filamentboot",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/filament-admin-oss",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/filament-admin-cos",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/filament-admin-rich-editor",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/filament-admin-markdown-editor",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/filament-admin-wang-editor",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/filament-admin-site",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "dedoc/scramble": "^0.13",
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.10",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "LaravelStack\\FilamentAdminCos\\": "packages/filament-admin-cos/src/",
            "LaravelStack\\FilamentAdminMarkdownEditor\\": "packages/filament-admin-markdown-editor/src/",
            "LaravelStack\\FilamentAdminOss\\": "packages/filament-admin-oss/src/",
            "LaravelStack\\FilamentAdminRichEditor\\": "packages/filament-admin-rich-editor/src/",
            "LaravelStack\\FilamentAdminSite\\": "packages/filament-admin-site/src/",
            "LaravelStack\\FilamentAdminSite\\Database\\Factories\\": "packages/filament-admin-site/database/factories/",
            "LaravelStack\\FilamentAdminSite\\Database\\Seeders\\": "packages/filament-admin-site/database/seeders/",
            "LaravelStack\\FilamentAdminWangEditor\\": "packages/filament-admin-wang-editor/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Filamentboot\\Tests\\": "packages/filamentboot/tests/",
            "LaravelStack\\FilamentAdminCos\\Tests\\": "packages/filament-admin-cos/tests/",
            "LaravelStack\\FilamentAdminMarkdownEditor\\Tests\\": "packages/filament-admin-markdown-editor/tests/",
            "LaravelStack\\FilamentAdminOss\\Tests\\": "packages/filament-admin-oss/tests/",
            "LaravelStack\\FilamentAdminRichEditor\\Tests\\": "packages/filament-admin-rich-editor/tests/",
            "LaravelStack\\FilamentAdminWangEditor\\Tests\\": "packages/filament-admin-wang-editor/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "phpstan": "vendor/bin/phpstan analyse",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravelstack/filament-admin"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
